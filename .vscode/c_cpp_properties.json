{
  "configurations": [
    {
      "name": "Croc CHERIoT",
      "includePath": [
        "${workspaceFolder}/cheriot-rtos/sdk/include",
        "${workspaceFolder}/cheriot-rtos/sdk/include/c++-config",
        "${workspaceFolder}/cheriot-rtos/sdk/include/libc++",
        "${workspaceFolder}/cheriot-rtos/sdk/include/platform/croc",
        "${workspaceFolder}/cheriot-rtos/sdk/include/platform/ibex",
        "${workspaceFolder}/cheriot-rtos/sdk/include/platform/generic-riscv",
        "${workspaceFolder}/sw/cheriot-rtos/hello_world",
        "${workspaceFolder}/sw/cheriot-rtos/test_exception_handling"
      ],
      "defines": [
        "CROC",
        "IBEX",
        "SIMULATION",
        "CPU_TIMER_HZ=20000000",
        "TICK_RATE_HZ=100"
      ],
      "compilerPath": "/usr/bin/gcc",
      "cStandard": "c17",
      "cppStandard": "c++23",
      "intelliSenseMode": "linux-gcc-x64"
    }
  ],
  "version": 4
}
